# ── Supabase ──────────────────────────────────────────────────────────────────
# Project dashboard → Settings → API. The anon key is safe to expose (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI providers (server-only — never NEXT_PUBLIC_) ──────────────────────────
# Gemini is the ONLY AI provider. Anthropic and DeepSeek have both been fully
# retired; their keys are dead and nothing in the codebase calls them.
# aistudio.google.com → API keys. Powers Kai (chat + report + consult translation).
# REQUIRED: src/lib/env.ts validates this at startup, so the app will not boot
# without it. Model is pinned to gemini-3.1-flash-lite in src/lib/gemini.ts.
GEMINI_API_KEY=your-gemini-api-key
# fish.audio/app/api-keys. Powers microphone transcription and Kai's spoken replies.
# Keep both values server-only: never prefix either name with NEXT_PUBLIC_.
FISH_AUDIO_API_KEY=your-fish-audio-api-key
# Voice/model ID copied from the Fish Audio voice page URL. Required for TTS;
# transcription only needs FISH_AUDIO_API_KEY.
FISH_AUDIO_VOICE=your-fish-audio-voice-id

# ── Translation (server-only) ─────────────────────────────────────────────────
# deepl.com/pro-api — primary translator
DEEPL_API_KEY=...
# console.cloud.google.com → Cloud Translation API — fallback translator
GOOGLE_TRANSLATE_KEY=...

# ── Email (server-only) ───────────────────────────────────────────────────────
# resend.com → API keys. Contact form delivery.
RESEND_API_KEY=re_...
# Optional contact-form delivery overrides. The defaults below match the route.
# Use a verified Resend sender for real delivery. This is the clinic contact
# form, not beta feedback; settings feedback currently has no email integration.
CONTACT_FROM_EMAIL=Keiro Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=keiro.contact@gmail.com
# Optional settings-feedback delivery overrides. Feedback is also stored in
# Supabase; notification delivery defaults to the project inbox below.
FEEDBACK_FROM_EMAIL=Keiro Feedback <onboarding@resend.dev>
FEEDBACK_TO_EMAIL=keirohealthcare@gmail.com

# ── Sentry error tracking ─────────────────────────────────────────────────────
# sentry.io → project settings. DSNs are safe to expose client-side.
NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
SENTRY_DSN=https://...ingest.sentry.io/...
# Build-time only: source map upload
SENTRY_ORG=your-org
SENTRY_PROJECT=keiro
SENTRY_AUTH_TOKEN=sntrys_...

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → Credentials. NOTE: these are configured in the
# Supabase dashboard (Auth → Providers → Google), kept here for reference only.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── PostHog analytics (client-side, consent-gated) ────────────────────────────
# us.posthog.com → project settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Deploy metadata (optional) ────────────────────────────────────────────────
# Set in Vercel env; surfaces in /api/health and log entries
DEPLOYMENT_VERSION=local

# ── App config ────────────────────────────────────────────────────────────────
# Canonical public site URL (absolute links / OG metadata). Verify domain ownership
# before deployment: the audit found keiro.app parked and Keiro on keiro.space.
NEXT_PUBLIC_SITE_URL=https://keiro.space
# Set to 'true' to bypass rate limiting — local dev / E2E only, never in production
RATE_LIMIT_DISABLED=false
# Optional shared secret to unlock the extended /api/health response (x-health-token)
HEALTH_CHECK_SECRET=
