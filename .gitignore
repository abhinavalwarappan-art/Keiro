# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every real .env stays out of git.
# .env.example is the ONE exception: it is the onboarding template (placeholder
# values only, no secrets), so it must be committed or it cannot onboard anyone.
# Keep the negation AFTER the .env* rule; git applies the last matching pattern.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local
.env.local
.gstack/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# graphify — generated knowledge-graph output (regenerate via run-graphify.sh)
/graphify-out/

# local editor / agent config (not shipped)
.claude/
.vscode/
